{% liquid
  assign top_image = section.settings.image
  assign mobile_top_image = section.settings.mobile_image | default: top_image
  assign side_image = section.settings.side_image
  assign mobile_side_image = section.settings.mobile_side_image | default: side_image
  assign header_logo = section.settings.header_logo
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<section
  class="gift-guide-hero"
  style="
    --gift-guide-total-height: 878px;
    --gift-guide-bar-height: 64px;
    --gift-guide-top-height: 390px;
    --gift-guide-footer-height: {% if section.settings.footer_text != blank %}34px{% else %}0px{% endif %};
    --gift-guide-image-x: {{ section.settings.image_position_x }}%;
    --gift-guide-image-y: {{ section.settings.image_position_y }}%;
    --gift-guide-mobile-image-x: {{ section.settings.mobile_image_position_x }}%;
    --gift-guide-mobile-image-y: {{ section.settings.mobile_image_position_y }}%;
    --gift-guide-side-image-x: {{ section.settings.side_image_position_x }}%;
    --gift-guide-side-image-y: {{ section.settings.side_image_position_y }}%;
  "
  >

  {%- comment -%} Checkbox powers the mobile menu without adding extra JavaScript. {%- endcomment -%}
  <input
    id="GiftGuideHeroMenu-{{ section.id }}"
    class="gift-guide-hero__menu-toggle"
    type="checkbox"
    aria-hidden="true"
  >

  <div class="gift-guide-hero__bar">
    <div class="gift-guide-hero__bar-inner">
      <label
        class="gift-guide-hero__menu-button gift-guide-hero__menu-button--open"
        for="GiftGuideHeroMenu-{{ section.id }}"
        aria-label="Open menu"
      >
        <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 6H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M1 1H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M1 11H19" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </label>

      <label
        class="gift-guide-hero__menu-button gift-guide-hero__menu-button--close"
        for="GiftGuideHeroMenu-{{ section.id }}"
        aria-label="Close menu"
      >
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 13.9994L13.7279 1.2715" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M1 1L13.7279 13.7279" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </label>

      <a class="gift-guide-hero__brand" href="{{ routes.root_url }}">
        {% if header_logo != blank %}
          {{
            header_logo
            | image_url: width: 420
            | image_tag:
              class: 'gift-guide-hero__brand-logo',
              widths: '160, 240, 320, 420',
              sizes: '(max-width: 749px) 220px, 240px',
              loading: 'eager',
              alt: header_logo.alt | default: section.settings.brand_text
          }}
        {% else %}
          {{ section.settings.brand_text | escape }}
        {% endif %}
      </a>

      {% if section.settings.bar_text != blank %}
        <p class="gift-guide-hero__bar-text">{{ section.settings.bar_text | escape }}</p>
      {% endif %}

      {% if section.settings.gift_button_text != blank %}
        <a
          class="gift-guide-hero__gift-button"
          {% if section.settings.gift_button_link != blank %}
            href="{{ section.settings.gift_button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.gift_button_text | escape }}</span>
          <svg aria-hidden="true" viewBox="0 0 31 12" fill="none">
            <path d="M0 6h29M24 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Mobile-only menu panel shown when the hamburger checkbox is checked. {%- endcomment -%}
  <div class="gift-guide-hero__mobile-menu">
    {% if section.settings.mobile_menu_text != blank %}
      <p class="gift-guide-hero__mobile-menu-text">{{ section.settings.mobile_menu_text | escape }}</p>
    {% endif %}

    {% if section.settings.gift_button_text != blank %}
      <a
        class="gift-guide-hero__gift-button gift-guide-hero__gift-button--mobile-menu"
        {% if section.settings.gift_button_link != blank %}
          href="{{ section.settings.gift_button_link }}"
        {% else %}
          role="link"
          aria-disabled="true"
        {% endif %}
      >
        <span>{{ section.settings.gift_button_text | escape }}</span>
        <svg aria-hidden="true" viewBox="0 0 31 12" fill="none">
          <path d="M0 6h29M24 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
    {% endif %}
  </div>

  <div class="gift-guide-hero__top-media">
    {% if top_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_top_image | image_url: width: 480 }} 480w,
              {{ mobile_top_image | image_url: width: 750 }} 750w,
              {{ mobile_top_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {% endif %}
        {{
          top_image
          | image_url: width: 2400
          | image_tag:
            class: 'gift-guide-hero__top-image',
            widths: '750, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: fetch_priority,
            alt: top_image.alt
        }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-guide-hero__top-image gift-guide-hero__placeholder' }}
    {% endif %}
  </div>

  <div class="gift-guide-hero__body">
    <div class="gift-guide-hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="gift-guide-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="gift-guide-hero__description gift-guide-hero__description--desktop">{{ section.settings.description }}</div>
      {% endif %}

      {%- comment -%} Mobile uses shorter copy to match the compact hero layout. {%- endcomment -%}
      {% if section.settings.mobile_description != blank %}
        <div class="gift-guide-hero__description gift-guide-hero__description--mobile">
          <p>{{ section.settings.mobile_description | escape }}</p>
        </div>
      {% endif %}

      {% if section.settings.shop_button_text != blank %}
        <a
          class="gift-guide-hero__shop-button"
          {% if section.settings.shop_button_link != blank %}
            href="{{ section.settings.shop_button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ section.settings.shop_button_text | escape }}</span>
          <svg aria-hidden="true" viewBox="0 0 31 12" fill="none">
            <path d="M0 6h29M24 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </a>
      {% endif %}
    </div>

    {%- comment -%} Mobile uses the top artwork here; desktop keeps this hidden. {%- endcomment -%}
    <div class="gift-guide-hero__mobile-media">
      {% if top_image != blank %}
        {{
          mobile_top_image
          | image_url: width: 1000
          | image_tag:
            class: 'gift-guide-hero__mobile-image',
            widths: '480, 750, 1000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: fetch_priority,
            alt: mobile_top_image.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-guide-hero__mobile-image gift-guide-hero__placeholder' }}
      {% endif %}
    </div>

    {%- comment -%} Desktop right-side artwork; hidden on mobile. {%- endcomment -%}
    <div class="gift-guide-hero__side-media">
      {% if side_image != blank %}
        <picture>
          {% if section.settings.mobile_side_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_side_image | image_url: width: 480 }} 480w,
                {{ mobile_side_image | image_url: width: 750 }} 750w,
                {{ mobile_side_image | image_url: width: 1000 }} 1000w
              "
              sizes="100vw"
            >
          {% endif %}
          {{
            side_image
            | image_url: width: 1800
            | image_tag:
              class: 'gift-guide-hero__side-image',
              widths: '750, 1000, 1400, 1800',
              sizes: '(min-width: 990px) 58vw, 100vw',
              loading: 'eager',
              fetchpriority: fetch_priority,
              alt: side_image.alt
          }}
        </picture>
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-guide-hero__side-image gift-guide-hero__placeholder' }}
      {% endif %}
    </div>
  </div>

  {% if section.settings.footer_text != blank %}
    <div class="gift-guide-hero__footer">
      {%- comment -%} Separate labels avoid forcing desktop wording into the mobile design. {%- endcomment -%}
      <span class="gift-guide-hero__footer-text gift-guide-hero__footer-text--desktop">
        {{ section.settings.footer_text | escape }}
      </span>
      <span class="gift-guide-hero__footer-text gift-guide-hero__footer-text--mobile">
        {{ section.settings.mobile_footer_text | escape }}
      </span>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .gift-guide-hero {
    width: 100%;
    height: var(--gift-guide-total-height);
    overflow: hidden;
    color: #000;
    background: #fff;
    font-family: Jost, var(--font-body--family);
  }

  .gift-guide-hero__bar {
    height: var(--gift-guide-bar-height);
    background: #f5f5f5;
  }

  .gift-guide-hero__menu-toggle,
  .gift-guide-hero__menu-button,
  .gift-guide-hero__mobile-menu {
    display: none;
  }

  .gift-guide-hero__bar-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    width: min(calc(100% - 32px), 1338px);
    height: 100%;
    margin-inline: auto;
    align-items: center;
    gap: 32px;
  }

  .gift-guide-hero__brand {
    width: fit-content;
    color: inherit;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .gift-guide-hero__brand-logo {
    display: block;
    width: auto;
    max-width: 240px;
    max-height: 42px;
  }

  .gift-guide-hero__bar-text {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  .gift-guide-hero__gift-button,
  .gift-guide-hero__shop-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .gift-guide-hero__gift-button {
    position: relative;
    justify-self: end;
    width: 230px;
    min-height: 48px;
    padding: 0 26px 0 46px;
    background: #fff544;
    overflow: hidden;
    transition: color 220ms ease;
  }

  .gift-guide-hero__gift-button::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms ease;
  }

  .gift-guide-hero__gift-button span,
  .gift-guide-hero__gift-button svg {
    position: relative;
    z-index: 1;
  }

  .gift-guide-hero__gift-button:hover,
  .gift-guide-hero__gift-button:focus-visible {
    color: #fff;
  }

  .gift-guide-hero__gift-button:hover::before,
  .gift-guide-hero__gift-button:focus-visible::before {
    transform: scaleX(1);
  }

  .gift-guide-hero__gift-button svg,
  .gift-guide-hero__shop-button svg {
    width: 31px;
    height: 12px;
    flex: none;
    transition: transform 180ms ease;
  }

  .gift-guide-hero__gift-button:hover svg,
  .gift-guide-hero__shop-button:hover svg {
    transform: translateX(4px);
  }

  .gift-guide-hero__top-media {
    height: var(--gift-guide-top-height);
    overflow: hidden;
    background: #fff;
  }

  .gift-guide-hero__top-media picture,
  .gift-guide-hero__side-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gift-guide-hero__top-image,
  .gift-guide-hero__side-image {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .gift-guide-hero__top-image {
    object-position: var(--gift-guide-image-x) var(--gift-guide-image-y);
  }

  .gift-guide-hero__side-image {
    object-position: var(--gift-guide-side-image-x) var(--gift-guide-side-image-y);
  }

  .gift-guide-hero__placeholder {
    background: #fff;
  }

  .gift-guide-hero__mobile-media {
    display: none;
  }

  .gift-guide-hero__body {
    display: grid;
    grid-template-columns: minmax(520px, 44%) minmax(0, 56%);
    width: 100%;
    height: calc(var(--gift-guide-total-height) - var(--gift-guide-bar-height) - var(--gift-guide-top-height) - var(--gift-guide-footer-height));
    overflow: hidden;
    background: #fff;
  }

  .gift-guide-hero__content {
    align-self: center;
    width: 100%;
    max-width: 720px;
    padding: 40px 32px 24px max(16px, calc((100vw - 1340px) / 2));
  }

  .gift-guide-hero__side-media {
    min-height: 100%;
    overflow: hidden;
  }

  .gift-guide-hero__heading {
    margin: 0 0 28px;
    font-family: Jost, var(--font-heading--family);
    font-size: 70px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    vertical-align: middle;
    white-space: nowrap;
  }

  .gift-guide-hero__description {
    max-width: 530px;
    margin-bottom: 30px;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.48;
  }

  .gift-guide-hero__description p {
    margin: 0;
    font-family: Jost, var(--font-body--family);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .gift-guide-hero__description--mobile {
    display: none;
  }

  .gift-guide-hero__shop-button {
    position: relative;
    width: 245px;
    min-height: 57px;
    padding: 0 25px 0 62px;
    color: #fff;
    background: #000;
    overflow: hidden;
    transition: color 220ms ease;
  }

  .gift-guide-hero__shop-button::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #fff544;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms ease;
  }

  .gift-guide-hero__shop-button span,
  .gift-guide-hero__shop-button svg {
    position: relative;
    z-index: 1;
  }

  .gift-guide-hero__shop-button:hover,
  .gift-guide-hero__shop-button:focus-visible {
    color: #000;
  }

  .gift-guide-hero__shop-button:hover::before,
  .gift-guide-hero__shop-button:focus-visible::before {
    transform: scaleX(1);
  }

  .gift-guide-hero__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--gift-guide-footer-height);
    padding: 0 20px;
    font-family: Jost, var(--font-body--family);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 13.42px;
    text-align: center;
    text-transform: uppercase;
    vertical-align: middle;
    background: #f5f5f5;
  }

  .gift-guide-hero__footer-text--mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .gift-guide-hero {
      height: auto;
      overflow: visible;
    }

    .gift-guide-hero__bar-inner {
      grid-template-columns: 1fr auto;
    }

    .gift-guide-hero__bar-text {
      display: none;
    }

    .gift-guide-hero__top-media {
      height: 360px;
    }

    .gift-guide-hero__body {
      grid-template-columns: 1fr;
      height: auto;
    }

    .gift-guide-hero__content {
      width: min(520px, calc(100% - 80px));
      max-width: none;
      padding: 48px 0;
      margin: 0 auto;
    }

    .gift-guide-hero__side-media {
      min-height: 360px;
    }
  }

  @media screen and (max-width: 749px) {
    .gift-guide-hero {
      background: #fff;
    }

    .gift-guide-hero__bar {
      height: 65px;
      min-height: 65px;
      box-shadow: 0 2px 4px 0 #00000026;
    }

    .gift-guide-hero__bar-inner {
      display: flex;
      position: relative;
      width: 100%;
      padding: 0 23px;
      justify-content: center;
      gap: 0;
    }

    .gift-guide-hero__menu-button {
      position: absolute;
      top: 50%;
      left: 23px;
      display: flex;
      width: 20px;
      height: 12px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transform: translateY(-50%);
    }

    .gift-guide-hero__menu-button svg {
      display: block;
      width: 20px;
      height: 12px;
    }

    .gift-guide-hero__menu-button span {
      display: block;
      width: 100%;
      height: 3px;
      background: #000;
      border-radius: 999px;
    }

    .gift-guide-hero__menu-button--close {
      width: 15px;
      height: 15px;
      justify-content: center;
    }

    .gift-guide-hero__menu-button--close svg {
      width: 15px;
      height: 15px;
    }

    .gift-guide-hero__menu-button--close,
    .gift-guide-hero__menu-toggle:checked ~ .gift-guide-hero__bar .gift-guide-hero__menu-button--open {
      display: none;
    }

    .gift-guide-hero__menu-toggle:checked ~ .gift-guide-hero__bar .gift-guide-hero__menu-button--close {
      display: flex;
    }

    .gift-guide-hero__brand {
      font-size: 31px;
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    .gift-guide-hero__brand-logo {
      max-width: 220px;
      max-height: 42px;
    }

    .gift-guide-hero__gift-button {
      display: none;
    }

    .gift-guide-hero__mobile-menu {
      display: block;
      max-height: 0;
      padding: 22px 28px 32px;
      overflow: hidden;
      opacity: 0;
      text-align: center;
      background: #f5f5f5;
      box-shadow: inset 0 4px 8px rgb(0 0 0 / 0.08);
      transform: translateY(-8px);
      transition: max-height 320ms ease, opacity 220ms ease, transform 320ms ease, padding-block 320ms ease;
    }

    .gift-guide-hero__menu-toggle:checked ~ .gift-guide-hero__mobile-menu {
      max-height: 190px;
      opacity: 1;
      transform: translateY(0);
    }

    .gift-guide-hero__mobile-menu-text {
      margin: 0 0 18px;
      font-family: Jost, var(--font-body--family);
      font-size: 21px;
      font-weight: 400;
      line-height: 1.25;
    }

    .gift-guide-hero__gift-button--mobile-menu {
      display: flex;
      width: min(338px, 100%);
      min-height: 61px;
      margin-inline: auto;
      padding: 0 36px 0 81px;
      justify-self: auto;
      font-size: 21px;
    }

    .gift-guide-hero__gift-button--mobile-menu svg {
      width: 42px;
      height: 16px;
    }

    .gift-guide-hero__top-media {
      display: none !important;
      height: 0;
    }

    .gift-guide-hero__top-image {
      object-position: var(--gift-guide-mobile-image-x) var(--gift-guide-mobile-image-y);
    }

    .gift-guide-hero__content {
      display: contents;
    }

    .gift-guide-hero__mobile-media {
      position: relative;
      display: block;
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      height: 268px;
      margin-top: 28px;
      overflow: hidden;
    }

    .gift-guide-hero__mobile-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--gift-guide-mobile-image-x) var(--gift-guide-mobile-image-y);
    }

    .gift-guide-hero__side-media {
      display: none;
    }

    .gift-guide-hero__side-media picture {
      height: auto;
    }

    .gift-guide-hero__side-image {
      width: 100%;
      object-position: var(--gift-guide-side-image-x) var(--gift-guide-side-image-y);
    }

    .gift-guide-hero__body {
      display: grid;
      grid-template-columns: 1fr;
      padding-top: 34px;
      text-align: center;
      overflow: hidden;
    }

    .gift-guide-hero__heading {
      grid-column: 1;
      grid-row: 1;
      width: calc(100% - 32px);
      margin: 0 auto 36px;
      font-size: 30px;
      font-weight: 500;
      line-height: 1;
      white-space: normal;
    }

    .gift-guide-hero__description {
      grid-column: 1;
      grid-row: 1;
      width: min(385px, calc(100% - 48px));
      margin: 60px auto 0;
      font-size: 21px;
      line-height: 1.4;
    }

    .gift-guide-hero__description--desktop {
      display: none;
    }

    .gift-guide-hero__description--mobile {
      display: block;
    }

    .gift-guide-hero__description p {
      font-size: 16px;
      line-height: 1.3;
    }

    .gift-guide-hero__shop-button {
      grid-column: 1;
      grid-row: 2;
      z-index: 1;
      align-self: start;
      width: 279px;
      min-height: 45px;
      margin: 188px auto 0;
      padding: 0 28px 0 61px;
      font-size: 16px;
    }

    .gift-guide-hero__footer {
      height: 58px;
      padding: 0 16px;
      font-size: 14px;
      line-height: 1.1;
      white-space: nowrap;
    }

    .gift-guide-hero__footer-text--desktop {
      display: none;
    }

    .gift-guide-hero__footer-text--mobile {
      display: inline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift guide hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Artwork"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Top desktop image"
